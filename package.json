{
  "name": "sanity-plugin-publish-timestamps",
  "version": "0.1.0",
  "description": "Absolute first-published and last-published timestamps in the Sanity Studio document footer",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "screenshot.png"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "sanity": "^4 || ^5 || ^6"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "react": "^19.2.2",
    "sanity": "^6.13.2",
    "typescript": "^5.9.3"
  }
}
